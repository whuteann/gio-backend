POSTGRES_USER=gio
POSTGRES_PASSWORD=gio
POSTGRES_DB=gio

DATABASE_URL=postgresql+psycopg2://gio:gio@db:5432/gio

SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated browser origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000

# Xendit payment gateway (docs/behaviour_log_0009.md) — use a test-mode
# secret key (xnd_development_...) for sandbox. Never commit a real value.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_SUCCESS_REDIRECT_URL=http://localhost:3000/membership/payment-success
XENDIT_FAILURE_REDIRECT_URL=http://localhost:3000/membership/payment-failed
XENDIT_ENVIRONMENT=sandbox

# Outbound email (app/services/mail.py). Required for the forgot-password
# flow — with MAIL_SERVER/MAIL_USERNAME/MAIL_PASSWORD unset, send_email()
# no-ops and POST /auth/forgot-password still answers 200 (it must, for
# enumeration safety), so the feature looks like it works and silently
# sends nothing. Verify with: python scripts/send_test_email.py you@example.com
# Port 465 uses implicit SSL; anything else uses STARTTLS.
# NOT in docker-compose.yaml's `environment:` block, so these reach the app
# via the bind-mounted .env — `docker compose restart app` is enough, no
# container recreate needed (docs/deployment_runbook.md §6).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Auren
MAIL_VERIFY_TLS=true
MAIL_TIMEOUT_SECONDS=20
